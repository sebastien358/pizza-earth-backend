{% apply inline_css %}
    <style>
        body { font-family: Arial, sans-serif; background: #fff4e3; margin: 0; padding: 0; }
        .wrapper { max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { background: #ff5a00; padding: 24px; text-align: center; border-radius: 16px 16px 0 0; }
        .header h1 { color: #fff; margin: 0; font-size: 24px; }
        .header p { color: #fff; margin: 4px 0 0; font-size: 13px; opacity: 0.9; }
        .box { background: #fff; padding: 24px; border-radius: 0 0 16px 16px; }
        .box h2 { color: #3b1f10; font-size: 18px; margin: 0 0 12px; }
        .row { margin: 8px 0; font-size: 14px; color: #3b1f10; }
        .row b { color: #ff5a00; }
        .message { background: #fff4e3; padding: 16px; border-radius: 12px; font-size: 14px; line-height: 1.5; margin-top: 16px; }
        .footer { text-align: center; font-size: 12px; color: #999; margin-top: 16px; }
    </style>

    <div class="wrapper">
        <div class="header">
            <h1>PIZZA EARTH</h1>
            <p>Des Pizzas Qui Aiment La Terre.</p>
        </div>
        <div class="box">
            <h2>Nouveau message reçu</h2>
            <p class="row"><b>Nom :</b> {{ name }}</p>
            <p class="row"><b>Email :</b> {{ email }}</p>
            <p class="row"><b>Sujet :</b> {{ subject }}</p>
            <div class="message">
                {{ message }}
            </div>
            <p class="row" style="margin-top:16px;">Tu peux répondre directement à {{ email }}.</p>
        </div>
        <p class="footer">Pizza Earth — Message envoyé depuis le formulaire de contact</p>
    </div>
{% endapply %}
