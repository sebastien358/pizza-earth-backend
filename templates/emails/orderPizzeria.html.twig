{% apply inline_css %}
<style>
    body { font-family: Arial, sans-serif; background: #fff4e3; margin: 0; padding: 0; }
    .wrapper { max-width: 600px; margin: 0 auto; padding: 20px; }
    .header { background: #ff5a00; padding: 24px; text-align: center; border-radius: 16px 16px 0 0; }
    .header h1 { color: #fff; margin: 0; font-size: 24px; }
    .box { background: #fff; padding: 24px; border-radius: 0 0 16px 16px; }
    .box h2 { color: #3b1f10; font-size: 18px; margin: 0 0 12px; }
    .row { margin: 8px 0; font-size: 14px; color: #3b1f10; }
    .row b { color: #ff5a00; }
    table { width: 100%; border-collapse: collapse; margin-top: 16px; }
    th { text-align: left; font-size: 13px; color: #999; border-bottom: 1px solid #eee; padding: 8px 0; }
    td { font-size: 14px; padding: 8px 0; border-bottom: 1px solid #f5f5f5; }
    .total { text-align: right; font-size: 16px; font-weight: bold; margin-top: 12px; }
    .footer { text-align: center; font-size: 12px; color: #999; margin-top: 16px; }
</style>
<div class="wrapper">
    <div class="header"><h1>PIZZA EARTH</h1></div>
    <div class="box">
        <h2>Nouvelle commande #{{ order.id }}</h2>
        <p class="row"><b>Client :</b> {{ name }} — {{ email }} — {{ phone }}</p>
        <p class="row"><b>Mode :</b> {{ order.deliveryMode }} — {{ order.city }} {{ order.postalCode }}</p>
        <table>
            <tr><th>Produit</th><th>Qté</th><th>Prix</th></tr>
            {% for item in items %}
            <tr>
                <td>{{ item.product.name }}</td>
                <td>{{ item.quantity }}</td>
                <td>{{ item.price }} €</td>
            </tr>
            {% endfor %}
        </table>
        <p class="total">Total : {{ total }} €</p>
    </div>
    <p class="footer">Pizza Earth — Nouvelle commande</p>
</div>
{% endapply %}
